#!/usr/bin/env bash
# sandbox: the single entry point for the job test sandbox (README.md; spec
# docs/superpowers/specs/2026-10-01-sandbox-ux-design.md). Only this script talks to Docker.
# Must run on macOS /bin/bash 3.2: no associative arrays, no mapfile, no ${x,,}.
set -euo pipefail

IMAGE="job-sandbox:base"
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
WORK="${SANDBOX_WORK_DIR:-$ROOT/work}"
PROJECT=/home/dev/project
HARDEN=(--user dev --cap-drop=ALL --security-opt no-new-privileges)

die() { echo "sandbox: $*" >&2; exit 1; }

usage() {
  cat <<'EOF'
Usage: sandbox <command> [args]

  build                            build the base image job-sandbox:base
  new <firm> <https-git-url|zip>   create volume jt-<firm> and fill it
  scan <firm> <read command>       read the code: no network, read-only
  up <firm> [--accept-question]    start code-server (needs a Green scan)
  stop <firm>                      stop the container; the volume stays
  exec <firm> <command>            run a command in the running container
  apply <firm> <patch-file>        apply a patch inside the container (or: < patch)
  export <firm>                    write bundle + zip to work/<firm>/out/
  rm <firm> [--yes]                delete the container and the volume
  status [firm] [--short]          every project, its state and the next step
EOF
}

docker_up() { docker version --format '{{.Server.Version}}' >/dev/null 2>&1; }
DOCKER_DOWN="cannot reach the Docker server: start OrbStack. From Claude, run one bin/sandbox command per Bash call, with no ; && or < redirect (otherwise it runs in Claude's Bash sandbox, which cannot reach Docker)."
need_docker() {
  command -v docker >/dev/null 2>&1 || die "docker not found; install OrbStack (FIRST-INSTALLATION.md, Task 1)"
  docker_up || die "$DOCKER_DOWN"
}
need_image() {
  docker image inspect "$IMAGE" >/dev/null 2>&1 || die "image $IMAGE is missing; run: sandbox build"
}
check_firm() {
  [[ "${1:-}" =~ ^[a-z0-9][a-z0-9-]{0,30}$ ]] ||
    die "firm must be lowercase letters, digits or dashes (got '${1:-}')"
}
volume_exists() { docker volume inspect "jt-$1" >/dev/null 2>&1; }
need_volume() { volume_exists "$1" || die "no project jt-$1; create it: sandbox new $1 <url|zip>"; }

# Prints running | stopped | missing.
container_state() {
  local r
  r="$(docker container inspect --format '{{.State.Running}}' "jt-$1" 2>/dev/null)" || { echo missing; return 0; }
  if [ "$r" = true ]; then echo running; else echo stopped; fi
}
need_running() { [ "$(container_state "$1")" = running ] || die "jt-$1 is not running; run: sandbox up $1"; }

# Prints Green | Question | Red | none, from work/<firm>/scan.md. Exactly one line may start
# with 'Verdict:' and it must be 'Verdict: Green|Question|Red'; zero or several give none.
scan_verdict() {
  local f="$WORK/$1/scan.md" v=""
  if [ -f "$f" ] && [ "$(grep -c '^Verdict:' "$f")" -eq 1 ]; then
    v="$(sed -n -E 's/^Verdict: (Green|Question|Red)[[:space:]]*$/\1/p' "$f")"
  fi
  echo "${v:-none}"
}

next_step() {  # firm verdict state
  case "$2/$3" in
    */running) echo "work at http://127.0.0.1:8443; when done: sandbox export $1" ;;
    none/*) echo "ask Claude \"scan $1\"" ;;
    Red/*) echo "do not run it: sandbox rm $1" ;;
    Question/*) echo "read work/$1/scan.md, then: sandbox up $1 --accept-question" ;;
    Green/*) echo "sandbox up $1" ;;
  esac
}

list_firms() { docker volume ls --format '{{.Name}}' | sed -n 's/^jt-//p'; }

# One line for the Claude statusline: the running project if any, else the first one.
short_status() {
  local f pick="" n=0
  for f in $1; do
    n=$((n + 1))
    if [ -z "$pick" ] || [ "$(container_state "$f")" = running ]; then pick="$f"; fi
  done
  local more=""
  [ "$n" -gt 1 ] && more=" (+$((n - 1)))"
  echo "🛡 sandbox: $pick · $(scan_verdict "$pick") · $(container_state "$pick")$more"
}

cmd_build() { need_docker; docker build -t "$IMAGE" "$ROOT/boilerplate"; }

cmd_new() {
  local firm="${1:-}" src="${2:-}"
  check_firm "$firm"
  [ -n "$src" ] || die "usage: sandbox new <firm> <https-git-url|zip>"
  case "$src" in
    https://*) ;;
    *.zip) [ -f "$src" ] || die "zip not found: $src" ;;
    *) die "source must be an https:// git URL or a .zip file (ssh URLs need keys the container must not have)" ;;
  esac
  need_docker; need_image
  if volume_exists "$firm"; then die "jt-$firm already exists; remove it first: sandbox rm $firm"; fi
  docker volume create "jt-$firm" >/dev/null
  local failed=0
  if [[ "$src" == https://* ]]; then
    # A private repo asks for a read-only token here; only a terminal can answer that.
    local tty=""
    if [ -t 0 ]; then tty="-it"; fi
    docker run --rm $tty "${HARDEN[@]}" -v "jt-$firm:$PROJECT" "$IMAGE" \
      git clone --no-recurse-submodules "$src" "$PROJECT" || failed=1
  else
    # Streamed through stdin so the Mac never unpacks it. A zip without .git becomes a repo,
    # so export (git bundle/archive) works.
    docker run --rm -i "${HARDEN[@]}" -v "jt-$firm:$PROJECT" -w "$PROJECT" "$IMAGE" \
      sh -c "cat > /tmp/t.zip && unzip -q /tmp/t.zip -d $PROJECT && if [ ! -d .git ]; then git init -q && git add -A && git -c user.name=sandbox -c user.email=sandbox@localhost commit -qm 'Import from zip'; fi" < "$src" || failed=1
  fi
  if [ "$failed" -ne 0 ]; then
    docker volume rm "jt-$firm" >/dev/null
    die "could not fill jt-$firm; the volume was removed"
  fi
  mkdir -p "$WORK/$firm"
  echo "Created jt-$firm. Next: ask Claude \"scan $firm\" (writes work/$firm/scan.md)."
}

# docs/reference.md, Phase 2 / Task 2: read commands only, and no way to start a program from the repo.
check_scan_command() {
  local a
  case "$1" in
    ls|cat|head|tail|grep|wc|file) ;;
    find)
      for a in "$@"; do
        case "$a" in
          -exec|-execdir|-ok|-okdir|-delete|-fprint|-fprint0|-fprintf|-fls) die "scan: find $a is not allowed" ;;
        esac
      done ;;
    git)
      case "${2:-}" in log|show) ;; *) die "scan allows only 'git log' and 'git show'" ;; esac
      for a in "$@"; do
        case "$a" in
          --ext-diff*|--textconv*|--show-signature*|--output*|--exec*|-c|-c*|*%G*)
            die "scan: git option $a could run a program from the repo" ;;
        esac
      done ;;
    *) die "scan allows only: ls find cat head tail grep wc file, git log, git show (got '$1')" ;;
  esac
}

cmd_scan() {
  local firm="${1:-}"
  check_firm "$firm"; shift
  [ $# -gt 0 ] || die "usage: sandbox scan <firm> <read command>"
  check_scan_command "$@"
  need_docker; need_image; need_volume "$firm"
  if [ "$1" = git ]; then
    # The repo's own git config could name programs (diff.external, textconv, fsmonitor, hooks).
    local sub="$2"; shift 2
    set -- git -c core.fsmonitor=false -c core.hooksPath=/dev/null -c diff.external= -c core.pager=cat \
      -c gpg.program=/bin/false -c core.attributesFile=/dev/null \
      "$sub" --no-ext-diff --no-textconv "$@"
  fi
  docker run --rm --network none --read-only "${HARDEN[@]}" \
    -v "jt-$firm:/src:ro" -w /src "$IMAGE" "$@"
}

cmd_status() {
  local a only="" short=""
  for a in "$@"; do case "$a" in --short) short=1 ;; *) only="$a" ;; esac; done
  if [ -n "$only" ]; then check_firm "$only"; fi
  if ! command -v docker >/dev/null 2>&1; then
    if [ -n "$short" ]; then echo "🛡 sandbox: docker not installed"; return 0; fi
    need_docker
  fi
  if ! docker_up; then
    if [ -n "$short" ]; then echo "🛡 sandbox: docker not reachable"; return 0; fi
    die "$DOCKER_DOWN"
  fi
  local firms
  if [ -n "$only" ]; then need_volume "$only"; firms="$only"; else firms="$(list_firms)"; fi
  if [ -z "$firms" ]; then
    if [ -n "$short" ]; then echo "🛡 sandbox: none"; else echo "No projects. Start one: sandbox new <firm> <url|zip>"; fi
    return 0
  fi
  if [ -n "$short" ]; then short_status "$firms"; return 0; fi
  local f v s
  for f in $firms; do
    v="$(scan_verdict "$f")"; s="$(container_state "$f")"
    printf '%s  scan=%s  container=%s  next: %s\n' "$f" "$v" "$s" "$(next_step "$f" "$v" "$s")"
  done
}

# README.md, Residual risks: the work container must not reach the Mac (OrbStack host, also its
# 127.0.0.1) or the LAN. A helper joins its network namespace with only NET_ADMIN and loads
# bin/container-firewall.sh; jt-<firm> keeps --cap-drop=ALL, so code in it cannot undo the rules.
# A restart loses them, so every up reruns it.
firewall_container() {
  if ! docker run --rm --network "container:jt-$1" --user root --cap-drop=ALL --cap-add NET_ADMIN \
    --security-opt no-new-privileges "$IMAGE" sh -c "$(cat "$ROOT/bin/container-firewall.sh")" >/dev/null; then
    docker stop "jt-$1" >/dev/null 2>&1 || true
    die "could not firewall jt-$1, so it was stopped. If the image predates the firewall, run: sandbox build"
  fi
}

cmd_up() {
  local firm="${1:-}" accept="${2:-}"
  check_firm "$firm"
  need_docker; need_image; need_volume "$firm"
  case "$(scan_verdict "$firm")" in
    Green) ;;
    Question) [ "$accept" = --accept-question ] ||
      die "scan verdict is Question; read work/$firm/scan.md, then: sandbox up $firm --accept-question" ;;
    Red) die "scan verdict is Red; do not run it. Remove it: sandbox rm $firm" ;;
    *) die "no 'Verdict:' line in work/$firm/scan.md; ask Claude \"scan $firm\" first" ;;
  esac
  local pwfile="$WORK/$firm/password"
  case "$(container_state "$firm")" in
    running) echo "jt-$firm is already running." ;;
    stopped) docker start "jt-$firm" >/dev/null ;;
    missing)
      mkdir -p "$WORK/$firm"
      ( umask 077; openssl rand -hex 12 > "$pwfile" )
      if ! docker run -d --name "jt-$firm" --hostname "jt-$firm" "${HARDEN[@]}" \
        --pids-limit 1024 --memory 6g --cpus 4 \
        -p 127.0.0.1:8443:8443 -p 127.0.0.1:5173:5173 \
        -e PASSWORD="$(cat "$pwfile")" \
        -v "jt-$firm:$PROJECT" "$IMAGE" \
        code-server --bind-addr 0.0.0.0:8443 --disable-telemetry "$PROJECT" >/dev/null; then
        docker rm -f "jt-$firm" >/dev/null 2>&1 || true
        die "could not start jt-$firm (are ports 8443/5173 used by another project? sandbox stop <other>)"
      fi ;;
  esac
  firewall_container "$firm"
  local pw="(missing: work/$firm/password)"
  if [ -f "$pwfile" ]; then pw="$(cat "$pwfile")"; fi
  echo "Open http://127.0.0.1:8443 in the sandbox browser profile. Password: $pw"
}

cmd_stop() {
  local firm="${1:-}"
  check_firm "$firm"
  need_docker
  if [ "$(container_state "$firm")" = running ]; then
    docker stop "jt-$firm" >/dev/null
    echo "Stopped jt-$firm. Start it again: sandbox up $firm"
  else
    echo "jt-$firm is not running."
  fi
}

cmd_exec() {
  local firm="${1:-}"
  check_firm "$firm"; shift
  [ $# -gt 0 ] || die "usage: sandbox exec <firm> <command>"
  need_docker; need_running "$firm"
  local tty=""
  if [ -t 0 ] && [ -t 1 ]; then tty="-it"; fi
  docker exec $tty --user dev -w "$PROJECT" "jt-$firm" "$@"
}

# The patch is written by Claude or you on the Mac; the test code itself never leaves the volume.
# Claude passes it as a file argument: `< file` would put the call inside Claude's Bash sandbox.
cmd_apply() {
  local firm="${1:-}" patch="${2:-}"
  check_firm "$firm"
  if [ -n "$patch" ]; then
    [ -f "$patch" ] || die "patch file not found: $patch"
  elif [ -t 0 ]; then
    die "give a patch: sandbox apply $firm change.patch (or pipe it in: < change.patch)"
  fi
  need_docker; need_running "$firm"
  if [ -n "$patch" ]; then
    docker exec -i --user dev -w "$PROJECT" "jt-$firm" git apply --whitespace=nowarn - < "$patch"
  else
    docker exec -i --user dev -w "$PROJECT" "jt-$firm" git apply --whitespace=nowarn -
  fi
  docker exec --user dev -w "$PROJECT" "jt-$firm" git diff --stat
}

cmd_export() {
  local firm="${1:-}"
  check_firm "$firm"
  need_docker; need_image; need_volume "$firm"
  local out="$WORK/$firm/out"
  mkdir -p "$out"
  # Written to .tmp and moved into place only on success, so a failure leaves no half file.
  local ext
  for ext in bundle zip; do
    if [ "$ext" = bundle ]; then set -- git bundle create - --all; else set -- git archive --format=zip HEAD; fi
    if ! docker run --rm --network none "${HARDEN[@]}" -v "jt-$firm:/src:ro" -w /src "$IMAGE" \
      "$@" > "$out/$firm.$ext.tmp"; then
      rm -f "$out/$firm.$ext.tmp"
      die "could not write $out/$firm.$ext"
    fi
    mv "$out/$firm.$ext.tmp" "$out/$firm.$ext"
  done
  echo "Wrote $out/$firm.bundle and $out/$firm.zip. Send or push them yourself (docs/reference.md, Phase 4 / Task 2)."
}

cmd_rm() {
  local firm="${1:-}" yes="${2:-}"
  check_firm "$firm"
  need_docker
  local state
  state="$(container_state "$firm")"
  if [ "$state" = missing ] && ! volume_exists "$firm"; then die "nothing to remove for $firm"; fi
  if [ "$yes" != --yes ]; then
    [ -t 0 ] || die "confirm with: sandbox rm $firm --yes"
    local answer
    read -r -p "Delete container and volume jt-$firm? Work not exported is lost. Type '$firm': " answer
    [ "$answer" = "$firm" ] || die "not confirmed; nothing removed"
  fi
  if [ "$state" != missing ]; then docker rm -f "jt-$firm" >/dev/null; fi
  if volume_exists "$firm"; then docker volume rm "jt-$firm" >/dev/null; fi
  echo "Removed jt-$firm. work/$firm/ is kept; delete it yourself when you no longer need it."
}

# Claude may touch test code only while the guard hook is registered in this repo's settings
# (docs/reference.md: Guardrails). Claude Code sets CLAUDECODE=1 for the commands it runs; your own
# terminal does not, so this never blocks you.
SETTINGS="${SANDBOX_SETTINGS:-$ROOT/.claude/settings.json}"
guard_on() { [ -f "$SETTINGS" ] && grep -q '\.claude/hooks/guard\.sh' "$SETTINGS"; }

cmd="${1:-}"
if [ $# -gt 0 ]; then shift; fi
case "$cmd" in
  new|scan|up|exec|apply|export)
    if [ -n "${CLAUDECODE:-}" ] && ! guard_on; then
      die "the guard is off ($SETTINGS does not register .claude/hooks/guard.sh), so Claude may not run '$cmd'. Switch it on: guard-on (or: mv .claude/settings.json.off .claude/settings.json)"
    fi ;;
esac
case "$cmd" in
  build|new|scan|up|stop|exec|apply|export|rm|status) "cmd_$cmd" "$@" ;;
  ""|-h|--help|help) usage ;;
  *) usage >&2; exit 2 ;;
esac
